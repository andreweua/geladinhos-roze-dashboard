# ==========================================================
# CONFIGURAÇÃO SUPABASE (OPCIONAL - MODO HÍBRIDO)
# ==========================================================
# Se deixado em branco, o dashboard funcionará automaticamente
# no Modo Demonstração Interativo (com persistência em LocalStorage).
# Quando preenchido, conectará diretamente ao banco PostgreSQL do Supabase.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
